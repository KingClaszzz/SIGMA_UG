# Salin menjadi server/.env (jangan di-commit). Semua nilai ada di dashboard Supabase.
# Project Settings → Database → Connection string (URI). Pakai "Transaction pooler" bila dari jaringan IPv4.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# "service_role" key. RAHASIA: hanya untuk server, jangan masuk klien atau git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sigma-berkas
PORT=3001
